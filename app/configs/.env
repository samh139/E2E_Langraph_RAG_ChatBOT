# =====================================================================
# 1. ELASTICSEARCH VECTOR STORAGE CONFIGURATION
# =====================================================================
ES_INDEX_NAME=es_documents
ES_CLUSTER_NAME=docsprawl-es
# Allocates 4GB heap space to match the ES_JAVA_OPTS rule in docker-compose
ES_HEAP=4g
ES_USERNAME= elastic
ES_PASSWORD=strongpassword123
ES_HOST=http://elasticsearch:9200


# =====================================================================
# 2. MINIO FILE STORAGE CONFIGURATION
# =====================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin_storage_user
MINIO_ROOT_PASSWORD=SuperSecretSecureMinioPassword123!
# The default internal initialization bucket where PDFs will land
MINIO_BUCKET=rag-raw-documents




# Change from localhost to container network names
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP=kafka:9092

OLLAMA_URL=http://host.docker.internal:11434

SUMMARY_MODEL=gemma3:1b


GOOGLE_APPLICATION_CREDENTIALS=/app/configs/e2e-langragh-chatbot-510511-cb0dd6b38e63.json
GEMINI_MODEL=gemini-2.5-flash

REDIS_HOST=redis
REDIS_PORT=6379