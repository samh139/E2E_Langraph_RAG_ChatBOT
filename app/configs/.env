# =====================================================================
# 1. ELASTICSEARCH VECTOR STORAGE CONFIGURATION
# =====================================================================
ES_INDEX_NAME=es_documents
ES_CLUSTER_NAME=docsprawl-es
# Allocates 4GB heap space to match the ES_JAVA_OPTS rule in docker-compose
ES_HEAP=4g
ES_USERNAME= elastic
ES_PASSWORD=strongpassword123
ES_HOST=http://elasticsearch:9200


# =====================================================================
# 2. MINIO FILE STORAGE CONFIGURATION
# =====================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin_storage_user
MINIO_ROOT_PASSWORD=SuperSecretSecureMinioPassword123!
# The default internal initialization bucket where PDFs will land
MINIO_BUCKET=rag-raw-documents




# Change from localhost to container network names
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP=kafka:9092

OLLAMA_URL=http://host.docker.internal:11434

SUMMARY_MODEL=gemma3:1b


GOOGLE_APPLICATION_CREDENTIALS=/app/configs/e2e-langragh-chatbot-510511-cb0dd6b38e63.json
GEMINI_MODEL=gemini-2.5-flash

REDIS_HOST=redis
REDIS_PORT=6379

# Local role testing: use these HS256 settings with create_test_token.py.
APP_ENV=development
JWT_ISSUER=local-rbac-test
JWT_AUDIENCE=banking-rag-chatbot
JWT_JWKS_URL=
JWT_PUBLIC_KEY=
JWT_ALGORITHMS=HS256
JWT_SECRET=15126521775dc5226ef2f78807afe58695e318a59717a59b45b2a264af85f25e
JWT_ROLES_CLAIM=roles
JWT_ALLOW_TEST_TOKEN_CREATION=true

# Generate a unique random value of at least 32 characters and share it only
# between the WebSocket gateway and retrieval-router through the local .env.
INTERNAL_CONTEXT_SECRET=dfe5c193d52771ee3ebf7e32167d429c74660bb2e225e3d96de1cd71a0dc3b1b
INTERNAL_CONTEXT_MAX_AGE_SECONDS=60

# Comma-separated exact browser origins allowed to open the WebSocket.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000

# Production: disable test-token creation and configure your IdP's issuer,
# audience, signing key/JWKS URL, and approved frontend origins instead.
